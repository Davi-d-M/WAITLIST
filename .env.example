NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
# Use the same PostHog project in Online Bar, Midnight Market, and the Waitlist.
# Session replay starts only after the visitor explicitly opts in.
NEXT_PUBLIC_POSTHOG_KEY=YOUR_POSTHOG_PROJECT_API_KEY
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_UI_HOST=https://us.posthog.com
NEXT_PUBLIC_POSTHOG_PROJECT_ID=YOUR_POSTHOG_PROJECT_ID
# Optional comma-separated list of areas currently served, e.g. Westlands,Kilimani
WAITLIST_LAUNCH_AREAS=
